[importlinter]
exclude_type_checking_imports = True
root_packages =
    domain
    application
    infrastructure
    interface
    shared
    features

[importlinter:contract:1]
name = Layering contract
type = layers
layers =
    interface
    application
    domain

[importlinter:contract:shared-is-leaf]
name = shared must not depend on features or app layers
type = forbidden
source_modules =
    shared
forbidden_modules =
    features
    domain
    application
    infrastructure
    interface

[importlinter:contract:feature-layers]
name = Inside each feature: router > services > domain (models, rules, repository ports)
type = layers
containers =
    features.benchmarks
    features.negotiation
    features.creators
    features.brands
    features.deals
    features.deliverables
    features.payments
    features.activity_log
    features.messages
    features.analytics
layers =
    (router)
    (service)
    (models) : (rules) : (repository)
