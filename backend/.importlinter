[importlinter]
exclude_type_checking_imports = True
root_packages =
    features
    shared

# 1. shared/ is a leaf: cross-cutting code may not depend on any feature.
[importlinter:contract:shared-is-leaf]
name = shared must not depend on features
type = forbidden
source_modules =
    shared
forbidden_modules =
    features
ignore_imports =
    # The Gemini adapter uses ClauseInput as its structured-output schema (runtime use).
    shared.llm.gemini_adapter -> features.contract_intelligence

# 2. Inside every feature: router > services > domain (models, rules, repository ports).
#    Layers are optional because not every feature has all of them.
#    Wiring modules (dependencies, supabase_repository, *_adapter) are composition code and unlisted.
[importlinter:contract:feature-layers]
name = Inside each feature: router > services > domain (models, rules, repository ports)
type = layers
containers =
    features.activity_log
    features.analytics
    features.auth
    features.benchmarks
    features.brands
    features.contract_intelligence
    features.contracts
    features.creators
    features.deals
    features.deliverables
    features.messages
    features.negotiation
    features.payments
    features.workspaces
layers =
    (router)
    (service) : (clause_explanation_service)
    (models) : (rules) : (red_flag_rules) : (escalation_rules) : (repository) : (email_port)
