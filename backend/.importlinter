[importlinter]
exclude_type_checking_imports = True
root_packages =
    domain
    application
    infrastructure
    interface
    shared
    features

[importlinter:contract:1]
name = Layering contract
type = layers
layers =
    interface
    application
    domain

[importlinter:contract:shared-is-leaf]
name = shared must not depend on features or app layers
type = forbidden
source_modules =
    shared
forbidden_modules =
    features
    domain
    application
    infrastructure
    interface
ignore_imports =
    # The Gemini adapter uses ClauseInput as its structured-output schema (runtime use).
    shared.llm.gemini_adapter -> features.contract_intelligence

[importlinter:contract:feature-layers]
name = Inside each feature: router > services > domain (models, rules, repository ports)
type = layers
containers =
    features.benchmarks
    features.auth
    features.contracts
    features.contract_intelligence
    features.negotiation
    features.creators
    features.brands
    features.deals
    features.deliverables
    features.payments
    features.activity_log
    features.messages
    features.analytics
layers =
    (router)
    (service) : (clause_explanation_service)
    (models) : (rules) : (red_flag_rules) : (escalation_rules) : (repository) : (email_port)
