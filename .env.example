# Creator OS — copy to `.env` at the repo root. Backend and frontend both read this one file.

# Backend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# development | production. In production the demo accounts are disabled even if Supabase is unreachable.
ENVIRONMENT=development
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-flash
TRANSACTIONAL_EMAIL_API_KEY=your-resend-api-key

# Frontend (NEXT_PUBLIC_* values are inlined into the browser bundle — never put secrets here)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
